module JoNCTTNative

public class JTTVoiceContent extends IScriptable {
  public static func Subtitle(tag: CName) -> String {
    switch tag {
      case n"jttnative_traumateam_355": return "Ok, we got a 3-5-5. We got a merc, V, who will team up with us as external subcontractor, part of the Trauma Team subexternal partnership. You know, reduce cost and all that shit.";
      case n"jttnative_traumateam_all injuries": return "Trauma module report that the victim have seveal injuries";
      case n"jttnative_traumateam_almost good": return "OK, we are almost good !";
      case n"jttnative_traumateam_area is safe": return "All right, area is safe. Go !";
      case n"jttnative_traumateam_area safe keep": return "Keep the area safe, the client is the priority ! V, move your ass !";
      case n"jttnative_traumateam_arrive soon": return "All right, we will arrive soon. Stay calm during the landing.";
      case n"jttnative_traumateam_ass covered": return "Don't mess with us, we got our ass covered !";
      case n"jttnative_traumateam_carnage": return "Fuck, it's a carnage.. Sergent... Fuck";
      case n"jttnative_traumateam_chaotic": return "placeholder";
      case n"jttnative_traumateam_cover us": return "Ok, victim is stable, we move to the AV ! V, cover us !";
      case n"jttnative_traumateam_do what m": return "I do what I can !";
      case n"jttnative_traumateam_end t1": return "T1, the medical assitance that you provide is good. Don't forget to flash the firmware on the secure boot if needed. T2,T3, and you, V, you were efficent to protect the area and the client. T2, I suggest next time that you need to be closer to the victim and the landing area.";
      case n"jttnative_traumateam_end v": return "V, the medical assitance that you provide is very good for a newcomer. Well done. T1,T2 and you,T3, you were efficent to protect the area and the client. T2, I suggest next time that you need to be closer to the victim and the landing area.";
      case n"jttnative_traumateam_evacuate_f": return "All right, heart rate is more than 50. We can evacuate the client.";
      case n"jttnative_traumateam_evacuate_m": return "All right, heart rate is more than 50. We can evacuate the client.";
      case n"jttnative_traumateam_focus near saving": return "Focus, you are near from saving a life !";
      case n"jttnative_traumateam_fortunately": return "Fortunately, there were no hostiles around. The mission could turn in another color if there was";
      case n"jttnative_traumateam_go back AV": return "Ok, V, you can go back to the AV !";
      case n"jttnative_traumateam_gogogo": return "Go ! Go ! Go !";
      case n"jttnative_traumateam_good hand": return "T1,T2 and T3, move the victim at the block. V, you was a good hand. Wait me 5 seconds";
      case n"jttnative_traumateam_good luck": return "Remember. Quick and safe. Be efficient and we must save the client. Good luck everyone.";
      case n"jttnative_traumateam_heart rate f": return "Heart rate continues to grow, I'm on it !";
      case n"jttnative_traumateam_heart rate low f": return "Heart rate is low, I'm on it !";
      case n"jttnative_traumateam_heart rate low m": return "Heart rate is low, I'm on it !";
      case n"jttnative_traumateam_heart_rate_trauma": return "Heart rate is low, I'm on it !";
      case n"jttnative_traumateam_heart rate m": return "Heart rate continues to grow, I'm on it !";
      case n"jttnative_traumateam_heyheyhey": return "Hey hey hey !!! It's Trauma Team!";
      case n"jttnative_traumateam_hostile": return "NCPD systems report that there is hostile presence around.";
      case n"jttnative_traumateam_hurry": return "I will say the briefing in the AV. Go inside ! Hurry !";
      case n"jttnative_traumateam_is lucky": return "It was short. 10 second later, neural circuits would be fried. That person is lucky.";
      case n"jttnative_traumateam_loss squad": return "We are aware about loss in squad. The client is still alive. At least, the mission is still a success.";
      case n"jttnative_traumateam_medical hud": return "I connect you to the medical HUD.";
      case n"jttnative_traumateam_memory": return "Fuck them off ! I lost my guys and they look at us like throwable meat.. Anyway, I will take a glass tonight. In memory, you see ?";
      case n"jttnative_traumateam_mission v stay alive f": return "Shit ! C'mon, stay alive !";
      case n"jttnative_traumateam_mission v stay alive m": return "Shit ! C'mon, stay alive !";
      case n"jttnative_traumateam_move out": return "Ok, vitals are stabilized. Move out !";
      case n"jttnative_traumateam_no hostile": return "NCPD systems report that there is no hostile presence around.";
      case n"jttnative_traumateam_protect area": return "The victim's health is low. Protect the area until we finish the first aid.";
      case n"jttnative_traumateam_protect the client": return "Shit ! Be careful there is some gangs around ! Protect the client !";
      case n"jttnative_traumateam_recovery ok": return "Recovery OK ! Reboot in progress...";
      case n"jttnative_traumateam_rescue extraction not possible": return "Extraction is not possible at your position. ";
      case n"jttnative_traumateam_rescue send squad": return "We send a squad to your position but stay hidden until they are here";
      case n"jttnative_traumateam_rescue squad living": return "You're safe. Squad is leaving. ";
      case n"jttnative_traumateam_rescue they will protect": return "They will protect you until you're out of danger. ";
      case n"jttnative_traumateam_secure the area": return "Vitals are low, secure the area. I will apply first aid to the victim.";
      case n"jttnative_traumateam_sending": return "Sending Short-Circuit broadcast to the area !";
      case n"jttnative_traumateam_stay focus": return "Stay calm, V ! Stay focused, we got you covered !";
      case n"jttnative_traumateam_surgery block": return "Ok, vitals function are still stable, we can move in the surgery block.";
      case n"jttnative_traumateam_t1 apply first aid": return "T1, your role is apply first aid and stabilize the health of the victim. T2,T3, me and you, V, we will secure the area and protect T1 during the intervention";
      case n"jttnative_traumateam_take that": return "Take that, fucker ! Stay down the line !";
      case n"jttnative_traumateam_thanks help": return "V, thanks for your help. It was efficient and clear. We like this kind of help any time so don't hesitate to take a new contract with us. Now, Dismiss !";
      case n"jttnative_traumateam_thanks joining": return "Thanks for joining the Trauma Team Subexternal Partnership Program. Get ready for the mission.";
      case n"jttnative_traumateam_tons of paper": return "Damn, theses gangs are more aggressive every days. Fortunately, no loss.. But I will have a tons of papers for that..";
      case n"jttnative_traumateam_up to doc": return "The vitals are ok now. Up to the doc to save the day.";
      case n"jttnative_traumateam_v apply first aid": return "V, your role is apply first aid and stabilize the health rate to 50. T1,T2,T3 and me, we will secure the area and protect V during the intervention.";
      case n"jttnative_traumateam_wait my instructions": return "We send a team for move the victim at the block. V, thanks for your help. Wait my instructions.";
      case n"jttnative_traumateam_whatever": return "V, Trauma Team thanks you for your help, whatever happens to the squad. They know the risk. Anyway, You can subscribe to our program when you need. Now, Dismiss !";
      case n"jttnative_traumateam_client_awake": return "The client is awake.";
      case n"jttnative_traumateam_confidential": return "Soldier ! Don't talk about that ! It's a confidential case.";
      case n"jttnative_traumateam_hardlife": return "A merc.. Theses guys got hard life...";
      case n"jttnative_traumateam_martinez": return "Remember that guy ? Martinez ? The corpse was completely destroyed after Smasher hit it.";
      case n"jttnative_traumateam_sergentjoy": return "Did you see the new sergeant's joy ?";
      case n"jttnative_traumateam_shine": return "The more it shines, the more it slips as he said...";
      case n"jttnative_traumateam_shutup": return "We will arrive. Shut up your mouth if you don't want any troubles !";
      case n"jttnative_traumateam_somechrome": return "Yeah she got some chrome at right place !";
      case n"jttnative_traumateam_thatshort": return "That's was short...";
      case n"jttnative_traumateam_whizzy": return "Man, I'm sure it's all about his Wizzy's obsession..";
      case n"jttnative_traumateam_yessir": return "Yes sir ! Sorry sir ! ";
    }
    return "";
  }
