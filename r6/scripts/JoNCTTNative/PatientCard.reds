  public func Dispose() {
    if IsDefined(this.root) && IsDefined(this.root.GetParentWidget()) { (this.root.GetParentWidget() as inkCompoundWidget).RemoveChild(this.root); }
    ArrayClear(this.widgets);
  }
  public func Refresh(patient: ref<JTTPatient>) {
    if !IsDefined(patient) { return; }
    (this.widgets[11] as inkText).SetText(StrReplace(StrReplace(" ##playerpositionx \n ##playerpositiony", "##playerpositionx", ToString(patient.location.X)), "##playerpositiony", ToString(patient.location.Y)));
    (this.widgets[16] as inkText).SetText(StrReplace(StrReplace("##name ##familyname", "##familyname", patient.familyName), "##name", patient.firstName));
    (this.widgets[19] as inkText).SetText(StrReplace("MEMBERSHIP ##timewait", "##timewait", patient.membership));
    (this.widgets[22] as inkText).SetText(StrReplace("##time", "##time", patient.injury));
    (this.widgets[24] as inkText).SetText(StrReplace("##time", "##time", ToString(patient.health)));
  }
}
